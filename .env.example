# ==================================================================
#  Polymarket BTC 5-min UP/DOWN Trading Bot -- Environment Config
#  ------------------------------------------------------------------
#  1. Copy this file to .env :   cp .env.example .env
#  2. Fill in your values below.
#  3. Validate:                  python scripts/check_config.py
#  You only ever edit THIS file -- never the Python code.
#  DO NOT commit .env to version control.
# ==================================================================

# ── Market cycle ──────────────────────────────────────────────────
# 5m  = BTC 5-minute UP/DOWN markets (default)
# 15m = BTC 15-minute UP/DOWN markets
MARKET_INTERVAL=5m

# ── Safety switches (BOTH must flip for real money) ───────────────
# DRY_RUN=true       -> paper trading only, no real orders (DEFAULT, SAFE)
# LIVE_TRADING=false -> live orders disabled (DEFAULT, SAFE)
# Real orders are placed ONLY when DRY_RUN=false AND LIVE_TRADING=true
# AND the bot is started with `python main.py --live`.
DRY_RUN=true
LIVE_TRADING=false

# ── Polymarket wallet / API credentials (required for --live) ─────
# POLYMARKET_PRIVATE_KEY  : private key of the EOA that SIGNS orders
# PM_FUNDER_ADDRESS       : address that HOLDS your USDC (Polymarket
#                           "Deposit" address; the proxy/Safe for
#                           MetaMask/email accounts -- NOT the EOA)
# POLYMARKET_SIG_TYPE     : 0=EOA  1=POLY_PROXY  2=POLY_GNOSIS_SAFE
# Generate the API key/secret/passphrase with:
#     python scripts/regen_polymarket_keys.py
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_API_KEY=...
POLYMARKET_API_SECRET=...
POLYMARKET_API_PASSPHRASE=...
PM_FUNDER_ADDRESS=0x...
POLYMARKET_SIG_TYPE=2
CHAIN_ID=137

# ── Network endpoints ─────────────────────────────────────────────
RPC_URL=https://polygon-rpc.com
WSS_URL=
# Override only if you proxy the public APIs:
# GAMMA_API_URL=https://gamma-api.polymarket.com
# CLOB_API_URL=https://clob.polymarket.com

# ── Rust 核心专用（行情 WebSocket）─────────────────────────────────
# Polymarket 盘口/订单簿 WebSocket 长连接地址（Rust 核心 jybot-rs 使用）
MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# WS 数据新鲜度阈值（秒）：缓存超过此值视为过期 → 回退 REST
WS_STALENESS_SEC=8
# Rust 实盘下单时调用的 Python 解释器（须装有 py-clob-client）
PYTHON_BIN=python3

# ── Order sizing & type ───────────────────────────────────────────
# FIXED_SHARES : fixed number of outcome shares per order (market min is 5)
# ORDER_TYPE   : FOK (fill-or-kill) | FAK (fill-and-kill) | GTC (rest)
# SLIPPAGE_BPS : added to best ask on BUY / subtracted from best bid on
#                SELL. 100 bps = 1.00%
# MAX_POSITION_USDC      : hard cap on notional per position
# MAX_TRADES_PER_MARKET  : entries allowed per 5-min market (1 = one bet)
FIXED_SHARES=5
ORDER_TYPE=FOK
SLIPPAGE_BPS=100
MAX_POSITION_USDC=5
MAX_TRADES_PER_MARKET=1

# ── Entry filters ─────────────────────────────────────────────────
# Refuse entries with price outside this band (extreme prices have poor EV)
MIN_ENTRY_PRICE=0.25
MAX_ENTRY_PRICE=0.75
# Skip trades when (ask-bid)/mid > MAX_SPREAD_PCT
MAX_SPREAD_PCT=0.05
# Do not enter within this many seconds of settlement
LATE_ENTRY_CUTOFF_SEC=45
# Do not enter before this many seconds have elapsed in the window (0=off)
EARLY_ENTRY_CUTOFF_SEC=0
# Minimum model edge (model prob - market ask) required to bet. 0.10 = 10pp
MIN_ML_EDGE=0.10

# ── Exits ─────────────────────────────────────────────────────────
# TAKE_PROFIT_PCT : TP = entry + TAKE_PROFIT_PCT * (1 - entry)
# ENABLE_STOP_LOSS: true -> exit early at STOP_LOSS_PCT below entry
# STOP_LOSS_PCT   : SL = entry - STOP_LOSS_PCT * entry
TAKE_PROFIT_PCT=0.40
ENABLE_STOP_LOSS=false
STOP_LOSS_PCT=0.50

# ── Runtime / signal ──────────────────────────────────────────────
POLL_INTERVAL_SEC=3
SIGNAL_LOOKBACK_MIN=3
# BTC price feed for the signal: binance | coinbase
PRICE_FEED=coinbase

# ── 策略模式 ──────────────────────────────────────────────────────
# momentum = 简单动量赌方向(默认; 真实数据回测证明不赚, 仅作基线)
# follow   = 顺势做市影子(复刻 JetFadil): 窗口内标的已朝某方向走时,
#            顺势接那一侧(drift>0接UP, drift<0接DOWN), 持有到结算。
#            真实数据: 顺势侧 edge ~+7.5%(maker), 逆势侧亏。
#            注意 dry-run 用 best_ask 模拟(taker)会高估成本; 真实需 maker 挂单。
STRATEGY=momentum
# follow 模式: 窗口内 drift 超过此值(bps, 1bp=0.01%)才顺势接单
DRIFT_ENTRY_BPS=5

# ─────────────────────────────────────────────────────────────────
# 【复刻 JetFadil 的推荐配置】(基于其 7 天真实成交 + 链上 + 订单簿反推)
# 三重验证结论: 顺势(已涨接UP/已跌接DOWN)有 +6~8% edge 且非走势泄漏;
#   逆势亏 -6~10%; taker/maker 混合吃单; 固定小单持有到结算。
# 用法: 把下面取消注释、覆盖上面对应项, 先 DRY_RUN=true 跑 3-5 天验证:
#   STRATEGY=follow
#   FIXED_SHARES=20          # 每单份额, 配几就是几(他用 10-20)
#   ORDER_TYPE=FAK           # 吃多少算多少, 剩余取消
#   SLIPPAGE_BPS=300         # 吃单深度. 注意: edge 在 0.55-0.65 最强,
#                            #   拉太大吃到高价会把 edge 吃光, 别真吃到 0.99
#   MAX_ENTRY_PRICE=0.85     # 顺势别追太贵(0.75+ 的高价侧 edge 转负)
#   MAX_POSITION_USDC=25     # 放开仓位上限(20份×~0.85≈17, 留余量)
#   EARLY_ENTRY_CUTOFF_SEC=60  # 等 drift 形成(开盘 1 分钟后再接)
#   LATE_ENTRY_CUTOFF_SEC=30   # 结算前 30 秒停止进场
#   DRIFT_ENTRY_BPS=3        # 窗口内涨跌超 3bp 才顺势接
#   MAX_TRADES_PER_MARKET=1  # 第一版每市场 1 单(他多档, 我们简化版)
# ─────────────────────────────────────────────────────────────────

# ── Redis (optional -- enables live mode switching without restart) ─
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
