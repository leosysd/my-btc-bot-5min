# ==================================================================
#  jybot-rs — Polymarket BTC 5分钟 UP/DOWN 顺势交易机器人  配置
#  ------------------------------------------------------------------
#  默认已是【复刻 JetFadil 的顺势策略 (STRATEGY=follow)】+ DRY_RUN 安全模拟。
#  开箱即用:只想纸面验证 -> 不用改任何东西,直接 `jybot start`。
#  要实盘    -> 填好下面第 6 节凭证 + 把第 1 节两个开关打开。
#  全局唯一配置文件: ~/.jybot/.env (任意目录的 jybot 都读它)。改完 `jybot check` 校验。
# ==================================================================

# ── 1. 安全开关 (实盘必须两个都改, 否则永远只是纸面模拟) ────────────
DRY_RUN=true              # true=纸面模拟(安全, 不下真单); 实盘改 false
LIVE_TRADING=false        # 实盘改 true (还需用 jybot --live 启动)

# ── 2. 市场周期 ────────────────────────────────────────────────────
MARKET_INTERVAL=5m        # 5m | 15m

# ── 3. 策略 (默认 follow = 顺势, 复刻 JetFadil) ─────────────────────
#   follow   = 顺势:窗口内BTC已涨接UP/已跌接DOWN, 一个盘口顺势多档加仓, 持有到结算。
#              真实数据三重验证(成交+链上+订单簿): 顺势 +6~8% edge, 逆势亏。
#   momentum = 简单动量赌方向(基线; 真实数据证明不赚, 不建议)。
STRATEGY=follow
DRIFT_ENTRY_BPS=3         # 窗口内BTC涨跌超此值(bps; 1bp=0.01%)才顺势接单
EARLY_ENTRY_CUTOFF_SEC=60 # 开盘后满这么多秒才接(等drift形成, 别一开盘就追)
LATE_ENTRY_CUTOFF_SEC=30  # 距结算少于这么多秒就停止进场

# ── 4. 下单 / 仓位 ─────────────────────────────────────────────────
FIXED_SHARES=20           # 每单份额(份数, 不是美元! 20份×价=实际花的钱)
ORDER_TYPE=FAK            # FAK=吃多少算多少(推荐) | FOK=全成或撤 | GTC=挂单
SLIPPAGE_BPS=1000         # 吃单深度(1000=10%); 真正卡价靠下面 MAX_ENTRY_PRICE
MIN_ENTRY_PRICE=0.10      # 低于此价不接(顺势低价 edge 最高, 别卡太高)
MAX_ENTRY_PRICE=0.89      # 高于此价不接(0.90+ 顺势 edge 转负)
MAX_POSITION_USDC=100     # 【一个盘口累积上限】follow 顺势加仓到此金额就停
MAX_TRADES_PER_MARKET=0   # 0=不限次数(一个盘口多档累积加仓); 1=每盘口只一笔
FEE_BPS=700               # Polymarket 对【赢利】收的手续费(700=7%, 实测值)。结算PnL会扣

# ── 5. 行情 / 信号 ─────────────────────────────────────────────────
PRICE_FEED=coinbase       # coinbase | binance (binance 部分地区被封)
POLL_INTERVAL_SEC=3       # 主循环间隔; 也是加仓节流:每这么多秒最多加一笔
SIGNAL_LOOKBACK_MIN=3
MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
WS_STALENESS_SEC=8        # 盘口 WS 超此秒数视为过期 → 回退 REST

# ── 6. 钱包 / API 凭证 (仅实盘 --live 需要; 纸面模拟可留空) ─────────
# PRIVATE_KEY=签名订单的EOA私钥;  PM_FUNDER_ADDRESS=持有USDC的Polymarket地址
# SIG_TYPE: 0=EOA 1=POLY_PROXY 2=POLY_GNOSIS_SAFE
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_API_KEY=...
POLYMARKET_API_SECRET=...
POLYMARKET_API_PASSPHRASE=...
PM_FUNDER_ADDRESS=0x...
POLYMARKET_SIG_TYPE=2
CHAIN_ID=137
PYTHON_BIN=python3        # 实盘下单调用的 Python(须装 py-clob-client)

# ── 7. 网络 ───────────────────────────────────────────────────────
RPC_URL=https://polygon-rpc.com
WSS_URL=
# 一般不用改; 需要代理公共API时再覆盖:
# GAMMA_API_URL=https://gamma-api.polymarket.com
# CLOB_API_URL=https://clob.polymarket.com

# ── 8. momentum 模式专用 (STRATEGY=follow 时这些都不生效) ──────────
MIN_ML_EDGE=0.10
MAX_SPREAD_PCT=0.05
TAKE_PROFIT_PCT=0.40
ENABLE_STOP_LOSS=false
STOP_LOSS_PCT=0.50

# ── 9. Redis (可选) ───────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
